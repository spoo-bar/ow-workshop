---
source: ow-workshop/tests/debug_panels.rs
expression: out.code
---
// ow-workshop debug build
variables {
    global:
        0: wave
        1: state
        2: internal
        3: spawns
    player:
        0: kills
        1: alive
}

rule ("Debug: globals") {
    event {
        Ongoing - Global;
    }
    actions {
        Create HUD Text(All Players(All Teams), Custom String("debug build"), Null, Null, Right, -2000, Color(Orange), Null, Null, Visible To Sort Order and String, Default Visibility);
        Create HUD Text(All Players(All Teams), Null, Null, Custom String("wave: {0}", Global.wave), Right, -1000, Null, Null, Color(Orange), Visible To Sort Order and String, Default Visibility);
        Create HUD Text(All Players(All Teams), Null, Null, Custom String("Phase: \"{0}\"", Global.state), Right, -999, Null, Null, Color(Orange), Visible To Sort Order and String, Default Visibility);
        Create HUD Text(All Players(All Teams), Null, Null, Custom String("spawns: {0}", Mapped Array(Mapped Array(Array(Mapped Array(Global.spawns, If-Then-Else(Or(Compare(Count Of(Current Array Element), ==, 1), And(Not(Current Array Element), Compare(Current Array Element, !=, Null))), Custom String("[{0}]", Current Array Element), If-Then-Else(Count Of(Current Array Element), Custom String("[{0}, …+{1}]", Current Array Element, Subtract(Count Of(Current Array Element), 1)), Current Array Element)))), Append To Array(Append To Array(Or(Count Of(Current Array Element), And(Not(Current Array Element), Compare(Current Array Element, !=, Null))), If-Then-Else(And(Not(Count Of(Current Array Element)), Compare(Current Array Element, !=, Empty Array)), 3, Multiply(Count Of(Current Array Element), 3))), Current Array Element)), If-Then-Else(First Of(Current Array Element), Custom String("[{0}{1}]", String Replace(Custom String("{0}, {1}, {2}", Value In Array(Current Array Element, 2), Value In Array(Current Array Element, 3), Custom String("{0}, {1}, {2}", Value In Array(Current Array Element, 4), Value In Array(Current Array Element, 5), Custom String("{0}, {1}, …", Value In Array(Current Array Element, 6), Value In Array(Current Array Element, 7)))), String Slice(Custom String("0, 0, 0, 0, 0, 0, …"), Add(-2, Value In Array(Current Array Element, 1)), Subtract(22, Value In Array(Current Array Element, 1))), Empty Array), If-Then-Else(Compare(Value In Array(Current Array Element, 1), >, 18), Custom String("+{0}", Subtract(Divide(Value In Array(Current Array Element, 1), 3), 6)), Empty Array)), String Split(Value In Array(Current Array Element, 2), Empty Array)))), Right, -998, Null, Null, Color(Orange), Visible To Sort Order and String, Default Visibility);
    }
}

rule ("Debug: players") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    actions {
        Create HUD Text(Event Player, Custom String("debug build"), Null, Null, Right, -2000, Color(Sky Blue), Null, Null, Visible To Sort Order and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("kills: {0}", (Event Player).kills), Right, -500, Null, Null, Color(Sky Blue), Visible To Sort Order and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("alive: {0}", (Event Player).alive), Right, -499, Null, Null, Color(Sky Blue), Visible To Sort Order and String, Default Visibility);
    }
}

rule ("Run") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(wave, 1);
        Set Global Variable(state, Custom String("playing"));
        Set Global Variable(spawns, Array(1, 2, 3));
    }
}

rule ("Score") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    actions {
        Set Player Variable(Event Player, kills, 0);
        Set Player Variable(Event Player, alive, True);
    }
}
