---
source: ow-workshop/tests/reference.rs
expression: "& output.code"
---
variables {
    global:
        0: A
        1: B
        2: C
        3: D
        4: E
    player:
        0: A
}

//Optimize for size enabled
rule ("0 to null") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(A, Compare(Global.B, >, Null));
        Set Global Variable(A, Compare(Null, >, Global.B));
        Set Global Variable(A, Compare(Global.B, >=, Null));
        Set Global Variable(A, Compare(Null, >=, Global.B));
        Set Global Variable(A, Compare(Global.B, <, Null));
        Set Global Variable(A, Compare(Null, <, Global.B));
        Set Global Variable(A, Compare(Global.B, <=, Null));
        Set Global Variable(A, Compare(Null, <=, Global.B));
        Set Global Variable(A, Append To Array(Global.B, Null));
        Set Global Variable(A, Array(Null, 1, Null));
        Set Global Variable(A, Array Contains(Global.B, Null));
        Set Global Variable(A, Not(Global.B));
        Set Global Variable(A, Not(Global.B));
        Set Global Variable(A, Compare(Global.B, !=, Null));
        Set Global Variable(A, Compare(Null, !=, Global.B));
        Set Global Variable(A, Custom String("000"));
        Set Global Variable(A, String("{0}, {1}, and {2}"));
        Big Message(All Players(All Teams), Null);
        Set Global Variable(A, Null);
        Set Player Variable(Global.B, A, Null);
        Small Message(All Players(All Teams), Null);
    }
}

rule ("0 to false") {
    event {
        Ongoing - Global;
    }
    actions {
        Set Global Variable(A, Max(False, Global.B));
        Set Global Variable(A, Max(Global.B, False));
        Set Global Variable(A, Min(False, Global.B));
        Set Global Variable(A, Min(Global.B, False));
        Set Global Variable(A, Random Integer(False, Global.B));
        Set Global Variable(A, Random Integer(Global.B, False));
        Set Global Variable(A, Subtract(False, Global.B));
        Set Global Variable(A, Add(Left, Right));
        Chase Global Variable At Rate(A, False, False, None);
        Chase Global Variable Over Time(A, False, False, None);
        Chase Player Variable At Rate(Global.B, A, False, False, None);
        Chase Player Variable Over Time(Global.B, A, False, False, None);
        Create Dummy Bot(Hero(Ana), Team 2, False, Global.B, Global.C);
        Create HUD Text(All Players(All Teams), Custom String("123"), Null, Null, Left, False, Color(White), Null, Null, Visible To, Visible Always);
        For Global Variable(A, 0, False, False);
        End;
        For Player Variable(Global.B, A, 0, False, False);
        End;
        Wait(False, Ignore Condition);
        Wait(False, Ignore Condition);
        Wait(False, Ignore Condition);
    }
}

rule ("1 to true") {
    event {
        Ongoing - Global;
    }
    conditions {
        "should not be changed, inequalities with true/false no longer work"
        Global.B > 1;
        1 > Global.B;
        Global.B >= 1;
        1 >= Global.B;
        Global.B < 1;
        1 < Global.B;
        Global.B <= 1;
        1 <= Global.B;
    }
    actions {
        Set Global Variable(A, Compare(Global.B, >, 1));
        Set Global Variable(A, Compare(1, >, Global.B));
        Set Global Variable(A, Compare(Global.B, >=, 1));
        Set Global Variable(A, Compare(1, >=, Global.B));
        Set Global Variable(A, Compare(Global.B, <, 1));
        Set Global Variable(A, Compare(1, <, Global.B));
        Set Global Variable(A, Compare(Global.B, <=, 1));
        Set Global Variable(A, Compare(1, <=, Global.B));
        Set Global Variable(A, Add(Global.B, True));
        Set Global Variable(A, Add(True, Global.B));
        Set Global Variable(A, Divide(True, Global.B));
        Set Global Variable(A, Max(True, Global.B));
        Set Global Variable(A, Max(Global.B, True));
        Set Global Variable(A, Min(True, Global.B));
        Set Global Variable(A, Min(Global.B, True));
        Set Global Variable(A, Random Integer(True, Global.B));
        Set Global Variable(A, Random Integer(Global.B, True));
        Set Global Variable(A, Subtract(True, Global.B));
        Set Global Variable(A, Subtract(Global.B, True));
        Set Global Variable(A, Value In Array(Global.B, True));
        Set Global Variable(A, Vector(True, True, True));
        Chase Global Variable At Rate(A, True, True, None);
        Chase Global Variable Over Time(A, True, True, None);
        Chase Player Variable At Rate(Global.B, A, True, True, None);
        Chase Player Variable Over Time(Global.B, A, True, True, None);
        Create Dummy Bot(Hero(Ana), Team 2, True, Global.B, Global.C);
        Create HUD Text(All Players(All Teams), Custom String("123"), Null, Null, Left, True, Color(White), Null, Null, Visible To, Visible Always);
        For Global Variable(A, 1, True, True);
        End;
        For Player Variable(Global.B, A, 1, True, True);
        End;
        Wait(True, Ignore Condition);
    }
}

rule ("null vector to null") {
    event {
        Ongoing - Global;
    }
    actions {
        Create Dummy Bot(Hero(Ana), Team 2, Global.A, Null, Null);
    }
}

rule ("empty string") {
    event {
        Ongoing - Global;
    }
    actions {
        Create HUD Text(All Players(All Teams), Global.A, Null, Null, Left, False, Color(White), Null, Null, Visible To Sort Order String and Color, Default Visibility);
        Set Global Variable(A, Index Of String Char(Empty Array, Global.B));
        Set Global Variable(A, Index Of String Char(Global.B, Empty Array));
        Set Global Variable(A, Char In String(Empty Array, Global.B));
        Set Global Variable(A, String Replace(Empty Array, Global.B, Global.C));
        Set Global Variable(A, String Replace(Global.B, Empty Array, Global.C));
        Set Global Variable(A, String Replace(Global.B, Global.C, Empty Array));
        Set Global Variable(A, String Split(Global.B, Empty Array));
        Set Global Variable(A, String Split(Empty Array, Global.B));
        Set Global Variable(A, String Slice(Empty Array, Global.B, Global.C));
        Set Global Variable(A, String Contains(Empty Array, Global.B));
        Set Global Variable(A, String Contains(Global.B, Empty Array));
        Set Global Variable(A, Char In String(Empty Array, False));
    }
}

rule ("if to skip if") {
    event {
        Ongoing - Global;
    }
    actions {
        "should be skip if"
        Skip If(Compare(Global.A, !=, Global.B), True);
        Set Global Variable(D, 4);
        //label_2:
        "pass"
        disabled Abort;
        "should stay if"
        If(Compare(Global.A, ==, Global.B));
            Set Global Variable(D, 4);
            Set Global Variable(E, 5);
        End;
        "should be skip if"
        Skip If(Global.B, 2);
        Set Global Variable(D, 4);
        Set Global Variable(E, 5);
        //label_3:
        "pass"
        disabled Abort;
        If(Compare(Global.A, ==, 2));
            Skip If(Compare(Global.A, !=, 3), True);
            Set Global Variable(B, 4);
            //label_4:
            "pass"
            disabled Abort;
            If(True);
                Skip(Value In Array(Array(1, 0), Add(True, Index Of Array Value(Array(Global.B), Global.A))));
                //label_1:
                Modify Global Variable(C, Add, True);
                //label_0:
            End;
            Modify Global Variable(D, Add, True);
            Modify Global Variable(E, Add, True);
        End;
        "should stay if"
        Skip If(Compare(Global.A, !=, Global.B), True);
        Set Global Variable(D, 4);
        //label_5:
        "pass"
        disabled Abort;
    }
}

rule ("auto array compression") {
    event {
        Ongoing - Global;
    }
    actions {
        "shouldn't be compressed"
        Set Global Variable(A, Array(Global.B, Global.B, Global.B, Global.B, Global.B, Global.B, Global.B, Global.B, Global.C));
        "shouldn't be compressed, can't nest mapped arrays"
        Set Global Variable(A, Mapped Array(Global.B, Add(Current Array Element, Array(Global.C, Global.C, Global.C, Global.C, Global.C, Global.C, Global.C))));
        "should be compressed"
        Set Global Variable(A, Array(Global.B, Global.B, Global.B, Global.B, Global.B, Global.B, Global.B, Global.B, Global.B));
        Set Global Variable(A, Array(Custom String("abc"), Custom String("def"), Custom String("ghi")));
        "shouldn't be compressed"
        Set Global Variable(A, Array(Custom String("abc"), Custom String("def"), Custom String("ghi{0}", Global.B)));
    }
}
