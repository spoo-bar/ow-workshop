rule ("Start match when teams are equal") {
    event {
        Ongoing - Global;
    }
    conditions {
        Is Game In Progress == False;
        Count Of(Filtered Array(All Players(Team 1), Not(Is Dummy Bot(Current Array Element)))) == Count Of(Filtered Array(All Players(Team 2), Not(Is Dummy Bot(Current Array Element))));
        Count Of(Filtered Array(All Players(Team 1), Not(Is Dummy Bot(Current Array Element)))) > 0;
    }
    actions {
        Start Game Mode;
    }
}

rule ("Warn about unequal teams") {
    event {
        Ongoing - Global;
    }
    actions {
        Create HUD Text(All Players(All Teams), If-Then-Else(And(Not(Is Game In Progress), Compare(Count Of(Filtered Array(All Players(Team 1), Not(Is Dummy Bot(Current Array Element)))), !=, Count Of(Filtered Array(All Players(Team 2), Not(Is Dummy Bot(Current Array Element)))))), Custom String("Both teams must have the same number of players"), Custom String("")), Null, Null, Top, 0, Custom Color(255, 112, 122, 255), Null, Null, Visible To and String, Default Visibility);
    }
}

rule ("Show buying help") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Dummy Bot(Event Player) == False;
    }
    actions {
        Create HUD Text(If-Then-Else((Event Player).isBuyer, Event Player, Null), Custom String("Aim at a hero and press {0} to buy it", Input Binding String(Button(Interact))), Null, Null, Top, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
    }
}

rule ("Show shop hero price") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Dummy Bot(Event Player) == True;
        (Event Player).isShopBot != False;
    }
    actions {
        Create In-World Text(All Players(All Teams), Custom String("{0}txc00000000008e02> {1}", Global.__holygrail__, (Event Player).botLevel), Add(Position Of(Event Player), Vector(0, 2.5, 0)), 1.2, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
        Set Player Variable(Event Player, priceTextId, Last Text ID);
        While((Event Player).isShopBot);
            Play Effect(All Players(All Teams), Ring Explosion, Color(White), Position Of(Event Player), 1.5);
            Wait(1, Ignore Condition);
        End;
    }
}

rule ("Place a bought hero on the point") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Dummy Bot(Event Player) == False;
        Is Game In Progress == True;
        Is In Setup == False;
        Is Between Rounds == False;
        Global.sellingActive == False;
        (Event Player).placedCount < Count Of((Event Player).purchased);
        Is Button Held(Event Player, Button(Interact)) == True;
    }
    actions {
        Set Player Variable(Event Player, placePosition, Ray Cast Hit Position(Eye Position(Event Player), Add(Eye Position(Event Player), Multiply(Facing Direction Of(Event Player), 60)), Null, Event Player, False));
        If(Compare(Distance Between(Vector(X Component Of((Event Player).placePosition), 0, Z Component Of((Event Player).placePosition)), Vector(X Component Of(Objective Position(Objective Index)), 0, Z Component Of(Objective Position(Objective Index)))), <=, 14));
            Create Effect(Event Player, Sphere, Color(Green), (Event Player).placePosition, 1, Visible To Position and Radius);
            Set Player Variable(Event Player, markerEffect, Last Created Entity);
            Create In-World Text(Event Player, Custom String("Selected for {0}: {1}. Confirm by clicking {2}", Value In Array((Event Player).purchased, (Event Player).placedCount), (Event Player).placePosition, Input Binding String(Button(Interact))), Add(Eye Position(Event Player), Multiply(Facing Direction Of(Event Player), 3)), 1.5, Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
            Set Player Variable(Event Player, confirmTextId, Last Text ID);
            Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 3);
            Wait Until(Is Button Held(Event Player, Button(Interact)), 1);
            If(Is Button Held(Event Player, Button(Interact)));
                Create Dummy Bot(Value In Array((Event Player).purchased, (Event Player).placedCount), Team Of(Event Player), -1, (Event Player).placePosition, Facing Direction Of(Event Player));
                Play Effect(All Players(All Teams), Good Pickup Effect, Color(Green), (Event Player).placePosition, 2);
                Modify Player Variable(Event Player, placedSlots, Append To Array, Slot Of(Last Created Entity));
                Modify Player Variable(Event Player, placedPositions, Append To Array, (Event Player).placePosition);
                Modify Player Variable(Event Player, placedCount, Add, 1);
            End;
            Destroy Effect((Event Player).markerEffect);
            Destroy In-World Text((Event Player).confirmTextId);
        Else;
            Big Message(Event Player, Custom String("Place heroes on the point"));
        End;
        Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 3);
    }
}

rule ("Show placing help") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Dummy Bot(Event Player) == False;
    }
    actions {
        Create HUD Text(If-Then-Else(And(And(And(And(Is Game In Progress, Not(Is In Setup)), Not(Is Between Rounds)), Not(Global.sellingActive)), Compare((Event Player).placedCount, <, Count Of((Event Player).purchased))), Event Player, Null), Custom String("Point at a spot on the point and press {0} to mark it, then press {0} again within 1 second to place {1}", Input Binding String(Button(Interact)), Value In Array((Event Player).purchased, (Event Player).placedCount)), Null, Null, Top, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
    }
}

rule ("Detect end of round") {
    event {
        Ongoing - Global;
    }
    conditions {
        Is Between Rounds == True;
    }
    actions {
        Set Global Variable(roundEnded, True);
    }
}

rule ("Award round gold") {
    event {
        Ongoing - Global;
    }
    conditions {
        Is Between Rounds == True;
    }
    actions {
        Modify Global Variable(roundsCompleted, Add, 1);
        Set Global Variable(roundWinner, If-Then-Else(Compare(Team Score(Team 1), >, Global.lastScore1), Team 1, Team 2));
        Set Global Variable(lastScore1, Team Score(Team 1));
        Set Global Variable(lastScore2, Team Score(Team 2));
        If(Compare(Global.roundsCompleted, <=, 4));
            For Global Variable(roundIndex, 0, Number Of Players(All Teams), 1);
                Set Global Variable(roundPlayer, Value In Array(All Players(All Teams), Global.roundIndex));
                If(Not(Is Dummy Bot(Global.roundPlayer)));
                    Modify Player Variable(Global.roundPlayer, coins, Add, Add(Add(1, Global.roundsCompleted), If-Then-Else(Compare(Team Of(Global.roundPlayer), ==, Global.roundWinner), 1, 0)));
                    Big Message(Global.roundPlayer, Custom String("{0} gold for {1}", Add(Add(1, Global.roundsCompleted), If-Then-Else(Compare(Team Of(Global.roundPlayer), ==, Global.roundWinner), 1, 0)), If-Then-Else(Compare(Team Of(Global.roundPlayer), ==, Global.roundWinner), Custom String("winning"), Custom String("losing"))));
                End;
            End;
    }
}

rule ("Reset selling for next round") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.roundEnded != False;
        Global.sellingRan != False;
        Global.sellingActive == False;
        Is In Setup == False;
        Is Between Rounds == False;
    }
    actions {
        Set Global Variable(roundEnded, False);
        Set Global Variable(sellingRan, False);
    }
}

rule ("Start selling phase") {
    event {
        Ongoing - Global;
    }
    conditions {
        Global.roundEnded != False;
        Is In Setup == True;
        Global.sellingRan == False;
    }
    actions {
        Set Global Variable(sellingRan, True);
        Set Global Variable(sellingActive, True);
        Big Message(All Players(All Teams), Custom String("Selling phase"));
        For Global Variable(sellRemaining, 30, 0, -1);
            If(Is In Setup);
                Set Match Time(30);
            End;
            Wait(1, Ignore Condition);
        End;
        Set Global Variable(sellingActive, False);
        Set Global Variable(sellRemaining, 0);
        Big Message(All Players(All Teams), Custom String("Buying phase"));
        If(Is In Setup);
            Set Match Time(30);
    }
}

rule ("Selling phase") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Dummy Bot(Event Player) == False;
        Global.sellingActive != False;
    }
    actions {
        For Player Variable(Event Player, cleanupIndex, 0, Count Of((Event Player).placedSlots), 1);
            Destroy Dummy Bot(Team Of(Event Player), Value In Array((Event Player).placedSlots, (Event Player).cleanupIndex));
        End;
        Set Player Variable(Event Player, placedSlots, Empty Array);
        Set Player Variable(Event Player, placedPositions, Empty Array);
        Set Player Variable(Event Player, placedCount, 0);
        Set Player Variable(Event Player, sellBots, Empty Array);
        Set Player Variable(Event Player, sellSlots, Empty Array);
        Set Player Variable(Event Player, facingAngle, Horizontal Angle From Direction(Facing Direction Of(Event Player)));
        Set Player Variable(Event Player, rowCenter, Add(Position Of(Event Player), Multiply(5, Direction From Angles((Event Player).facingAngle, 0))));
        For Player Variable(Event Player, optionIndex, 0, Count Of((Event Player).purchased), 1);
            Set Player Variable(Event Player, optionPosition, Add((Event Player).rowCenter, Multiply(Multiply(Subtract((Event Player).optionIndex, Divide(Subtract(Count Of((Event Player).purchased), 1), 2)), 2.5), Direction From Angles(Add((Event Player).facingAngle, 90), 0))));
            Create Dummy Bot(Value In Array((Event Player).purchased, (Event Player).optionIndex), Team Of(Event Player), -1, (Event Player).optionPosition, Direction Towards((Event Player).optionPosition, Position Of(Event Player)));
            Set Player Variable(Last Created Entity, isShopBot, True);
            Set Player Variable(Last Created Entity, botLevel, Value In Array((Event Player).purchasedLevels, (Event Player).optionIndex));
            Modify Player Variable(Event Player, sellBots, Append To Array, Last Created Entity);
            Modify Player Variable(Event Player, sellSlots, Append To Array, Slot Of(Last Created Entity));
        End;
        Set Player Variable(Event Player, isSeller, True);
        Wait Until(Not(Global.sellingActive), 35);
        Set Player Variable(Event Player, isSeller, False);
        For Player Variable(Event Player, cleanupIndex, 0, Count Of((Event Player).sellSlots), 1);
            If(Compare(Value In Array((Event Player).sellSlots, (Event Player).cleanupIndex), >=, 0));
                Destroy In-World Text((Value In Array((Event Player).sellBots, (Event Player).cleanupIndex)).priceTextId);
                Destroy Dummy Bot(Team Of(Event Player), Value In Array((Event Player).sellSlots, (Event Player).cleanupIndex));
            End;
        End;
        Set Player Variable(Event Player, keptHeroes, Empty Array);
        Set Player Variable(Event Player, keptLevels, Empty Array);
        For Player Variable(Event Player, cleanupIndex, 0, Count Of((Event Player).sellSlots), 1);
            If(Compare(Value In Array((Event Player).sellSlots, (Event Player).cleanupIndex), >=, 0));
                Modify Player Variable(Event Player, keptHeroes, Append To Array, Value In Array((Event Player).purchased, (Event Player).cleanupIndex));
                Modify Player Variable(Event Player, keptLevels, Append To Array, Value In Array((Event Player).purchasedLevels, (Event Player).cleanupIndex));
            End;
        End;
        Set Player Variable(Event Player, purchased, (Event Player).keptHeroes);
        Set Player Variable(Event Player, purchasedLevels, (Event Player).keptLevels);
        Set Player Variable(Event Player, sellBots, Empty Array);
        Set Player Variable(Event Player, sellSlots, Empty Array);
    }
}

rule ("Sell a hero by gripping it") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        (Event Player).isSeller != False;
        Is Button Held(Event Player, Button(Interact)) == True;
    }
    actions {
        Set Player Variable(Event Player, targetBot, First Of(Sorted Array(Filtered Array(All Living Players(Team Of(Event Player)), And(Has Spawned(Current Array Element), Compare(Current Array Element, !=, Event Player))), Angle Between Vectors(Facing Direction Of(Event Player), Subtract(Current Array Element, Eye Position(Event Player))))));
        Set Player Variable(Event Player, targetIndex, Index Of Array Value((Event Player).sellBots, (Event Player).targetBot));
        If(And(And(Compare((Event Player).targetIndex, >=, 0), Compare(Value In Array((Event Player).sellSlots, (Event Player).targetIndex), >=, 0)), Compare(Angle Between Vectors(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Position Of((Event Player).targetBot))), <, 15)));
            Modify Player Variable(Event Player, coins, Add, Value In Array((Event Player).purchasedLevels, (Event Player).targetIndex));
            Play Effect(All Players(All Teams), Good Pickup Effect, Color(White), Position Of((Event Player).targetBot), 2);
            Destroy In-World Text(((Event Player).targetBot).priceTextId);
            Destroy Dummy Bot(Team Of(Event Player), Value In Array((Event Player).sellSlots, (Event Player).targetIndex));
            Set Player Variable At Index(Event Player, sellSlots, (Event Player).targetIndex, -1);
        End;
        Wait Until(Not(Is Button Held(Event Player, Button(Interact))), 3);
    }
}

rule ("Show selling phase") {
    event {
        Ongoing - Global;
    }
    actions {
        Create HUD Text(All Players(All Teams), If-Then-Else(Global.sellingActive, Custom String("Selling phase: {0} s", Global.sellRemaining), Custom String("")), Null, Null, Top, 0, Color(Yellow), Null, Null, Visible To and String, Default Visibility);
    }
}

rule ("Show selling help") {
    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Dummy Bot(Event Player) == False;
    }
    actions {
        Create HUD Text(If-Then-Else((Event Player).isSeller, Event Player, Null), Custom String("Aim at a hero and press {0} to sell it for its level in gold", Input Binding String(Button(Interact))), Null, Null, Top, 2, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
    }
}
