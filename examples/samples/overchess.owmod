    event {
        Ongoing - Each Player;
        All;
        All;
    }
    conditions {
        Is Dummy Bot(Event Player) == False;
    }
    actions {
        Create HUD Text(If-Then-Else(Compare(Count Of((Event Player).purchased), >, 0), Event Player, Null), Null, Null, If-Then-Else(And((Event Player).isSeller, Compare(First Of((Event Player).sellSlots), <, 0)), Custom String("{0} {1}txc00000000008e02>{2}", First Of((Event Player).purchased), Global.__holygrail__, Custom String("{0}{1} sold", If-Then-Else(Compare(First Of((Event Player).purchasedLevels), >=, 2), Custom String("{0}txc00000000008e02>", Global.__holygrail__), Custom String("")), If-Then-Else(Compare(First Of((Event Player).purchasedLevels), >=, 3), Custom String("{0}txc00000000008e02>", Global.__holygrail__), Custom String("")))), If-Then-Else(Compare(0, <, (Event Player).placedCount), Custom String("{0} {1}txc00000000008e02>{2}", First Of((Event Player).purchased), Global.__holygrail__, Custom String("{0}{1} placed at {2}", If-Then-Else(Compare(First Of((Event Player).purchasedLevels), >=, 2), Custom String("{0}txc00000000008e02>", Global.__holygrail__), Custom String("")), If-Then-Else(Compare(First Of((Event Player).purchasedLevels), >=, 3), Custom String("{0}txc00000000008e02>", Global.__holygrail__), Custom String("")), First Of((Event Player).placedPositions))), Custom String("{0} {1}txc00000000008e02>{2}", First Of((Event Player).purchased), Global.__holygrail__, Custom String("{0}{1} bought", If-Then-Else(Compare(First Of((Event Player).purchasedLevels), >=, 2), Custom String("{0}txc00000000008e02>", Global.__holygrail__), Custom String("")), If-Then-Else(Compare(First Of((Event Player).purchasedLevels), >=, 3), Custom String("{0}txc00000000008e02>", Global.__holygrail__), Custom String("")))))), Right, 1, Color(White), Color(White), Color(White), Visible To Sort Order and String, Default Visibility);
